              "patterns": [
                     {
                            "pattern": "(?i)^\\s*\\[\\s*Exits:\\s*(.*)\\]",
                            "type": "regex"
                     },
                     {
                            "pattern": "^\\s*There (?:is|are) \\w+ (?:visible|obvious) exit[s]?:\\s*(.*)",
                            "type": "regex"
                     },
                     {
                            "pattern": "^\\[?[\\s\\w]*(?:[Vv]isible|[Oo]bvious) (?:[Pp]ath|[Ee]xit)[s]?(?: is| are)?:?\\s*(.*)\\]?",
                            "type": "regex"
                     },
                     {
                            "pattern": "^\\s*You see[\\w\\s]* exit[s]? leading (.*)",
                            "type": "regex"
                     },
                     {
                            "pattern": "Exits:\\s*(.*)",
                            "type": "regex"
                     },
                     {
                            "pattern": "There are no obvious exits.",
                            "type": "startOfLine"
                     },
                     {
                            "pattern": "^\\s*The (?:only )?obvious exit[s]? (?:is|are):? (.*)",
                            "type": "regex"
                     }
              ],
              "script": ""
